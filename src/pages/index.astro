---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ValueSection from '../components/ValueSection.astro';
import WhySection from '../components/WhySection.astro';
import UseCases from '../components/UseCases.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import SocialProof from '../components/SocialProof.astro';
import PortfolioFilter from '../components/PortfolioFilter.astro';
import MarketInsights from '../components/MarketInsights.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQ from '../components/FAQ.astro';
import InquirySection from '../components/InquirySection.astro';
import ExitIntent from '../components/ExitIntent.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Nav />
  <main id="main-content">
    <Hero />
    <ValueSection />
    <WhySection />
    <UseCases />
    <ClosingCTA />
    <SocialProof />
    <PortfolioFilter />
    <PricingSection />
    <MarketInsights />
    <FAQ />
    <InquirySection />
    <Footer />
  </main>
  <ExitIntent />
</BaseLayout>

<script>
  // ---- Conversion tracking helper (dataLayer + data-track attrs; works with CF Web Analytics / GTM) ----
  function trackEvent(name, data) {
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: name, ...data });
    } catch (e) { /* no-op */ }
  }
  document.querySelectorAll('[data-track]').forEach((el) => {
    el.addEventListener('click', () => {
      trackEvent('cta_click', { cta: el.getAttribute('data-track'), page: location.pathname });
    });
  });

  // Nav scroll effect
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
  }, { passive: true });

  // Mobile menu toggle (48px target + aria-expanded)
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  function setMenu(open) {
    if (!mobileMenu || !mobileBtn) return;
    mobileMenu.classList.toggle('hidden', !open);
    mobileBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    const icon = mobileBtn.querySelector('svg');
    if (icon) {
      icon.innerHTML = open
        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6h12v12" />'
        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
    }
    document.body.style.overflow = open ? 'hidden' : '';
  }
  mobileBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    setMenu(!!isHidden);
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });

  // Smooth scroll for anchor links (offset for fixed nav)
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href')?.substring(1);
      const target = targetId ? document.getElementById(targetId) : null;
      if (target) {
        e.preventDefault();
        const offset = 80;
        const bodyRect = document.body.getBoundingClientRect().top;
        const elementPosition = target.getBoundingClientRect().top;
        const offsetPosition = elementPosition - bodyRect - offset;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
        setMenu(false);
      }
    });
  });

  // ---- Theme toggle (dark default, light option; persisted) ----
  const root = document.documentElement;
  const moonIcon = document.getElementById('theme-icon-moon');
  const sunIcon = document.getElementById('theme-icon-sun');
  function applyTheme(theme) {
    root.setAttribute('data-theme', theme);
    try { localStorage.setItem('saf-theme', theme); } catch (e) { /* no-op */ }
    const isLight = theme === 'light';
    moonIcon?.classList.toggle('hidden', isLight);
    sunIcon?.classList.toggle('hidden', !isLight);
  }
  try {
    const saved = localStorage.getItem('saf-theme');
    if (saved === 'light' || saved === 'dark') applyTheme(saved);
  } catch (e) { /* no-op */ }
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    applyTheme(root.getAttribute('data-theme') === 'light' ? 'dark' : 'light');
    trackEvent('theme_toggle', { theme: root.getAttribute('data-theme') });
  });

  // ---- Scroll-reveal animations (fade-ins; disabled with reduced motion) ----
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = document.querySelectorAll('.reveal');
  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach((el) => observer.observe(el));
  }

  // ---- Urgency: stable-ish weekly viewer count (session-persisted) ----
  try {
    let viewers = sessionStorage.getItem('saf-viewers');
    if (!viewers) {
      viewers = String(11 + Math.floor(Math.random() * 14)); // 11–24
      sessionStorage.setItem('saf-viewers', viewers);
    }
    const vc = document.getElementById('viewer-count');
    if (vc && viewers) vc.textContent = viewers;
  } catch (e) { /* no-op */ }

  // ---- Exit-intent popup (desktop mouse-out + 45s mobile fallback; once per session) ----
  const popup = document.getElementById('exit-popup');
  let exitShown = false;
  try { exitShown = sessionStorage.getItem('saf-exit-shown') === '1'; } catch (e) { /* no-op */ }
  function showExitPopup() {
    if (exitShown || !popup) return;
    exitShown = true;
    try { sessionStorage.setItem('saf-exit-shown', '1'); } catch (e) { /* no-op */ }
    popup.classList.remove('hidden');
    popup.classList.add('flex');
    trackEvent('exit_intent_shown', {});
    document.getElementById('exit-popup-close')?.focus();
  }
  function hideExitPopup() {
    popup?.classList.add('hidden');
    popup?.classList.remove('flex');
  }
  document.addEventListener('mouseout', (e) => {
    if (!e.relatedTarget && e.clientY <= 0) showExitPopup();
  });
  setTimeout(() => {
    // Only auto-nudge on touch devices that never trigger mouseout
    if (window.matchMedia('(hover: none)').matches) showExitPopup();
  }, 45000);
  document.getElementById('exit-popup-close')?.addEventListener('click', hideExitPopup);
  document.getElementById('exit-popup-dismiss')?.addEventListener('click', hideExitPopup);
  document.getElementById('exit-popup-backdrop')?.addEventListener('click', hideExitPopup);

  // ---- Form handling with validation + honeypot + tracking ----
  const form = document.getElementById('inquiry-form');
  const successMsg = document.getElementById('success-message');
  const formError = document.getElementById('form-error');
  form?.addEventListener('submit', function(e) {
    e.preventDefault();
    formError?.classList.add('hidden');
    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
    const honeypot = (document.getElementById('company-website') as HTMLInputElement)?.value;
    if (honeypot) return; // silent drop for bots
    if (!name || name.length < 2) {
      if (formError) { formError.textContent = 'Please enter your full name.'; formError.classList.remove('hidden'); }
      (document.getElementById('name') as HTMLInputElement)?.focus();
      return;
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (formError) { formError.textContent = 'Please enter a valid email address.'; formError.classList.remove('hidden'); }
      (document.getElementById('email') as HTMLInputElement)?.focus();
      return;
    }
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn?.innerHTML || '';
    if (submitBtn) {
      submitBtn.innerHTML = 'Processing...';
      (submitBtn as HTMLButtonElement).disabled = true;
    }
    trackEvent('inquiry_submit', { timeline: (document.getElementById('timeline') as HTMLSelectElement)?.value || 'unspecified' });
    setTimeout(() => {
      if (form) form.style.display = 'none';
      successMsg?.classList.remove('hidden');
      successMsg?.classList.add('block');
      // Mailto fallback keeps the free plan (no backend): open prefilled email for the seller.
      const subject = encodeURIComponent('Acquisition Inquiry - secureaiframeworks.xyz');
      const body = encodeURIComponent(
        `Hello,\n\nI am interested in acquiring secureaiframeworks.xyz.\n\nName: ${name}\nEmail: ${email}\nOrg: ${(document.getElementById('org') as HTMLInputElement)?.value || '-'}\nOffer: ${(document.getElementById('offer') as HTMLInputElement)?.value || '-'}\nTimeline: ${(document.getElementById('timeline') as HTMLSelectElement)?.value || '-'}\nMessage: ${(document.getElementById('message') as HTMLTextAreaElement)?.value || '-'}\n\nBest regards,`
      );
      try { window.location.href = `mailto:sales@desertrich.com?subject=${subject}&body=${body}`; } catch (err) { /* no-op */ }
      console.log('%c[secureaiframeworks.xyz] New inquiry submitted:', 'color:#64748b', { name, email });
      if (submitBtn) { (submitBtn as HTMLButtonElement).disabled = false; submitBtn.innerHTML = originalText; }
    }, 850);
  });

  // Reset form
  document.getElementById('reset-form-btn')?.addEventListener('click', () => {
    if (form) {
      form.style.display = 'block';
      (form as HTMLFormElement).reset();
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        (submitBtn as HTMLButtonElement).disabled = false;
        submitBtn.innerHTML = 'Submit Secure Inquiry';
      }
    }
    successMsg?.classList.add('hidden');
    successMsg?.classList.remove('block');
  });

  // Keyboard accessibility
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) setMenu(false);
      hideExitPopup();
    }
  });

  console.log('%c[secureaiframeworks.xyz] Premium domain landing page initialized.', 'color:#475569; font-size:9px');
</script>
