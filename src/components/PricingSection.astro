---
import { ACQUISITION_MAILTO, SITE } from '../config/site';

const buyNowHref = `mailto:${SITE.email}?subject=${encodeURIComponent('Buy Now - secureaiframeworks.xyz ($9,997)')}&body=${encodeURIComponent('Hello,\n\nI would like to purchase secureaiframeworks.xyz at the listed price of $9,997 USD via Escrow.com. Please send next steps.\n\nName:\nTimeline:\n\nBest regards,')}`;
const makeOfferHref = `mailto:${SITE.email}?subject=${encodeURIComponent('Offer - secureaiframeworks.xyz')}&body=${encodeURIComponent('Hello,\n\nI would like to make an offer for secureaiframeworks.xyz.\n\nMy offer (USD):\nTimeline:\nIntended use:\n\nBest regards,')}`;
---

<section id="pricing" class="max-w-4xl mx-auto px-6 py-20 reveal">
  <div class="text-center mb-10">
    <div class="inline-block px-4 py-1 rounded-full bg-emerald-400/10 text-emerald-400 text-xs tracking-[1.5px] font-semibold mb-4">PREMIUM ACQUISITION</div>
    <h2 class="section-header tracking-[-0.03em]">A clean, modern asset for forward-thinking teams.</h2>
    <p class="mt-3 text-sm text-white/60">Buy it now, make an offer, or talk to an agent — your choice.</p>
  </div>

  <div class="glass rounded-3xl p-10 md:p-14">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-y-8">
      <div>
        <div class="flex items-baseline gap-x-2">
          <span class="text-6xl md:text-7xl font-semibold tracking-tighter">$9,997</span>
          <span class="text-white/50 text-xl">USD</span>
        </div>
        <p class="mt-1 text-white/60">One-time acquisition • Full ownership &amp; instant transfer</p>
        <p class="mt-2 text-xs text-amber-300/90">List price valid through Dec 31, 2027 • Single asset — when it's gone, it's gone.</p>

        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <div class="flex items-center gap-x-2 text-white/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
            <span>Clean title, ready for transfer</span>
          </div>
          <div class="flex items-center gap-x-2 text-white/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
            <span>Escrow.com protected transaction</span>
          </div>
          <div class="flex items-center gap-x-2 text-white/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
            <span>Transaction guarantee — funds released only on transfer</span>
          </div>
        </div>
      </div>

      <div class="md:text-right md:min-w-[240px]">
        <div class="flex flex-col gap-3">
          <a href={buyNowHref} data-track="cta-pricing-buy-now"
             class="inline-flex w-full items-center justify-center px-10 py-4 min-h-[48px] rounded-3xl bg-white font-semibold text-[#0a0a0f] text-lg active:scale-[0.985] transition-all hover:bg-white/90">
            Buy Now
          </a>
          <a href="#inquire" data-track="cta-pricing-make-offer"
             class="inline-flex w-full items-center justify-center px-10 py-3.5 min-h-[48px] rounded-3xl border border-white/20 font-semibold text-white text-base hover:bg-white/5 transition-colors">
            Make an Offer
          </a>
          <a href={ACQUISITION_MAILTO} data-track="cta-pricing-contact-agent"
             class="inline-flex w-full items-center justify-center px-10 py-3 min-h-[48px] rounded-3xl text-sm font-medium text-white/70 hover:text-white underline underline-offset-4 transition-colors">
            Contact Agent
          </a>
        </div>
        <p class="text-xs text-white/50 mt-3">Serious buyers only. Flexible terms available.</p>
      </div>
    </div>
  </div>

  <!-- Trust signals -->
  <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 text-center text-xs text-white/60">
    <div class="glass rounded-2xl px-4 py-3">🔒 SSL Secured Inquiry</div>
    <div class="glass rounded-2xl px-4 py-3">🛡️ Escrow.com Guarantee</div>
    <div class="glass rounded-2xl px-4 py-3">⚡ Instant Transfer</div>
    <div class="glass rounded-2xl px-4 py-3">✓ Clean Title Verified</div>
  </div>

  <div class="mt-8 text-center">
    <p class="text-xs text-white/50 max-w-md mx-auto">
      Modern, clean .xyz domains with strong keyword relevance in emerging tech categories offer excellent brand value for forward-thinking teams.
    </p>
  </div>
</section>
