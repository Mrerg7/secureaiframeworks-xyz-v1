---
import { SITE } from '../config/site';
---

<nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/5">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#main-content" class="flex items-center gap-x-3 min-h-[48px]" aria-label="secureaiframeworks.xyz — back to top">
        <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-[#22f5ff] via-[#a855f7] to-[#22f5ff] p-px" aria-hidden="true">
          <div class="w-full h-full bg-[#0a0a0f] rounded-2xl flex items-center justify-center">
            <span class="text-[#22f5ff] text-lg font-bold tracking-tighter">SAF</span>
          </div>
        </div>
        <div class="font-display text-lg sm:text-2xl font-semibold tracking-tighter truncate max-w-[11rem] sm:max-w-none">
          {SITE.name}
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-x-9 text-sm font-medium">
        <a href="#positioning" class="text-white/80 hover:text-white transition-colors py-2">The Opportunity</a>
        <a href="#why" class="text-white/80 hover:text-white transition-colors py-2">Why This Domain</a>
        <a href="#uses" class="text-white/80 hover:text-white transition-colors py-2">Ideal For</a>
        <a href="#portfolio" class="text-white/80 hover:text-white transition-colors py-2">Fit</a>
        <a href="#pricing" class="text-white/80 hover:text-white transition-colors py-2">Pricing</a>
        <a href="#faq" class="text-white/80 hover:text-white transition-colors py-2">FAQ</a>
      </div>

      <!-- CTA Buttons -->
      <div class="flex items-center gap-x-3">
        <button id="theme-toggle"
                type="button"
                class="w-12 h-12 min-w-[48px] min-h-[48px] hidden sm:inline-flex items-center justify-center rounded-2xl border border-white/20 text-white/70 hover:text-white hover:bg-white/5 transition-colors"
                aria-label="Toggle light and dark mode"
                title="Toggle light / dark mode">
          <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
          </svg>
          <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.4-6.4l-1.4 1.4M7 17l-1.4 1.4M17 17l1.4 1.4M7 7L5.6 5.6M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
        <a href="#inquire" data-track="cta-nav-inquire"
           class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 min-h-[44px] text-sm font-semibold rounded-2xl border border-white/20 hover:bg-white/5 transition-colors">
          Inquire
        </a>
        <a href="#pricing" data-track="cta-nav-secure"
           class="inline-flex items-center justify-center px-6 py-2.5 min-h-[44px] text-sm font-semibold rounded-2xl bg-white text-[#0a0a0f] hover:bg-white/90 transition-all active:scale-[0.985]">
          Secure Now
        </a>

        <!-- Mobile Menu Button (48px tap target) -->
        <button id="mobile-menu-btn"
                type="button"
                class="md:hidden w-12 h-12 min-w-[48px] min-h-[48px] flex items-center justify-center text-white/70 hover:text-white transition-colors"
                aria-label="Toggle menu"
                aria-expanded="false"
                aria-controls="mobile-menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-40 bg-[#0a0a0f] pt-20">
    <div class="px-6 py-8 flex flex-col gap-y-2 text-lg font-medium">
      <a href="#positioning" class="mobile-nav-link py-3 min-h-[48px] flex items-center">The Opportunity</a>
      <a href="#why" class="mobile-nav-link py-3 min-h-[48px] flex items-center">Why This Domain</a>
      <a href="#uses" class="mobile-nav-link py-3 min-h-[48px] flex items-center">Ideal For</a>
      <a href="#portfolio" class="mobile-nav-link py-3 min-h-[48px] flex items-center">Fit</a>
      <a href="#pricing" class="mobile-nav-link py-3 min-h-[48px] flex items-center">Pricing</a>
      <a href="#faq" class="mobile-nav-link py-3 min-h-[48px] flex items-center">FAQ</a>
      <div class="pt-4 border-t border-white/10">
        <a href="#inquire" class="mobile-nav-link flex w-full text-center py-4 min-h-[48px] items-center justify-center rounded-2xl bg-white text-[#0a0a0f] font-semibold">Secure This Domain</a>
      </div>
    </div>
  </div>
</nav>
