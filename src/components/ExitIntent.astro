---
// Exit-intent email capture: shows once per session when the cursor leaves the
// viewport top (desktop) or after 45s dwell (mobile fallback). Free-plan friendly:
// mailto-based capture, no backend or paid binding.
import { SITE } from '../config/site';
---

<div id="exit-popup" class="hidden fixed inset-0 z-[90] items-center justify-center p-6" role="dialog" aria-modal="true" aria-labelledby="exit-popup-title">
  <div id="exit-popup-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
  <div class="relative glass rounded-3xl p-8 md:p-10 max-w-md w-full text-center border border-[#22f5ff]/25">
    <button id="exit-popup-close" type="button" aria-label="Close offer" class="absolute top-4 right-4 w-12 h-12 min-w-[48px] min-h-[48px] flex items-center justify-center rounded-full text-white/60 hover:text-white hover:bg-white/10 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <p class="text-xs uppercase tracking-[2px] text-[#22f5ff] font-semibold mb-3">Before you go</p>
    <h2 id="exit-popup-title" class="text-2xl font-semibold tracking-tight mb-3">Get the acquisition brief for secureaiframeworks.xyz</h2>
    <p class="text-white/70 text-sm mb-6">Price justification, comparable sales &amp; escrow steps — sent to your inbox. No spam, ever.</p>
    <a
      href={`mailto:${SITE.email}?subject=${encodeURIComponent('Send me the acquisition brief - secureaiframeworks.xyz')}&body=${encodeURIComponent('Hello,\n\nPlease send the acquisition brief for secureaiframeworks.xyz to this email address.\n\nBest regards,')}`}
      data-track="cta-exit-intent-brief"
      class="inline-flex w-full items-center justify-center px-6 py-4 min-h-[48px] rounded-2xl bg-gradient-to-r from-[#22f5ff] to-[#a855f7] text-[#0a0a0f] font-semibold hover:brightness-105 transition-all"
    >
      Email Me the Brief
    </a>
    <button id="exit-popup-dismiss" type="button" class="mt-4 text-sm text-white/50 hover:text-white/80 underline underline-offset-4 min-h-[44px] px-4">No thanks, I'll keep browsing</button>
  </div>
</div>
