---
const faqs = [
  {
    q: 'Is secureaiframeworks.xyz for sale?',
    a: 'Yes. secureaiframeworks.xyz is a premium domain name available for acquisition by the owner. Serious buyers can submit an inquiry through the form on this page or email sales@desertrich.com. We respond personally within 24 hours.',
  },
  {
    q: 'How much does secureaiframeworks.xyz cost?',
    a: 'The listed acquisition price is $9,997 USD, one-time, with full ownership and instant transfer. Flexible terms are available for qualified buyers.',
  },
  {
    q: 'How do I buy secureaiframeworks.xyz?',
    a: 'Submit the inquiry form on this page or email sales@desertrich.com with your offer and timeline. Every transaction is completed through Escrow.com so funds and domain transfer are both protected.',
  },
  {
    q: 'What is secureaiframeworks.xyz designed for?',
    a: 'secureaiframeworks.xyz is the natural brand home for secure AI frameworks, AI security platforms, AI guardrails, runtime safety layers, AI governance and compliance tools, and open-source projects building trustworthy AI.',
  },
  {
    q: 'Why is secureaiframeworks.xyz a strong domain for an AI security brand?',
    a: 'The name is an exact, memorable keyword match for "secure AI frameworks" — the category buyers and practitioners search for — and the modern .xyz extension signals a tech-native, next-generation brand rather than a legacy one.',
  },
  {
    q: 'Is the domain transfer safe?',
    a: 'Yes. All acquisitions are escrow-protected via Escrow.com. The domain has a clean title and can be pushed or transferred immediately after escrow clears.',
  },
];
---

<section id="faq" class="bg-white/5 border-t border-white/10 py-16">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-10">
      <div class="inline-block px-4 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-3">FREQUENTLY ASKED QUESTIONS</div>
      <h2 class="section-header tracking-[-0.03em]">Everything buyers ask about this domain.</h2>
    </div>

    <div class="space-y-4">
      {faqs.map((item) => (
        <details class="glass rounded-3xl px-7 py-5 group">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4 font-semibold text-white/90 hover:text-white transition-colors">
            <span>{item.q}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 mt-0.5 text-[#22f5ff] transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </summary>
          <p class="mt-3 text-white/70 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
})} />
