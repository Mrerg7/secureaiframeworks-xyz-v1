---
// Portfolio / internal-linking hub: category filtering for buyer intent
// (crypto, business, geo, brandable mapped to AI-security buyer segments).
// Single-asset site: filters re-rank the use-case cards and deep-link to inquiry
// with a prefilled angle, creating crawlable internal anchor equity.
const categories = [
  { id: 'all', label: 'All opportunities' },
  { id: 'brandable', label: 'Brandable' },
  { id: 'exact', label: 'Exact-match' },
  { id: 'startup', label: 'Startup-ready' },
  { id: 'enterprise', label: 'Enterprise' },
];

const items = [
  { name: 'Next-Gen AI Security Platforms', cat: 'enterprise exact', href: '#uses', blurb: 'Flagship domain for guardrails & runtime safety layers.' },
  { name: 'Startup & Scale-Up AI Security', cat: 'startup brandable', href: '#uses', blurb: 'Tech-native .xyz brand that signals the future.' },
  { name: 'Open-Source Secure AI Frameworks', cat: 'brandable', href: '#uses', blurb: 'Community-friendly, memorable, easy to type.' },
  { name: 'Developer-First AI Security Tools', cat: 'startup exact', href: '#uses', blurb: 'Docs, SDKs & CLIs live naturally here.' },
  { name: 'Innovation Labs & Research', cat: 'enterprise', href: '#uses', blurb: 'Credible home for responsible-AI programs.' },
  { name: 'AI Governance & Compliance', cat: 'enterprise exact', href: '#uses', blurb: 'Exact keyword match buyers already search for.' },
];
---

<section id="portfolio" class="max-w-6xl mx-auto px-6 py-20 reveal" aria-labelledby="portfolio-heading">
  <div class="max-w-2xl mb-8">
    <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">PORTFOLIO & FIT</div>
    <h2 id="portfolio-heading" class="section-header tracking-[-0.035em] leading-none">One domain. Six ways to win.</h2>
    <p class="mt-3 text-white/60">Filter by buyer profile — every path leads to the same acquisition, framed for your use case.</p>
  </div>

  <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter opportunities by category">
    {categories.map((c, i) => (
      <button
        type="button"
        data-filter={c.id}
        aria-pressed={i === 0 ? 'true' : 'false'}
        class="portfolio-filter px-5 py-2.5 min-h-[44px] rounded-full text-sm font-medium border border-white/15 text-white/70 hover:bg-white/5 transition-colors data-[active=true]:bg-white data-[active=true]:text-[#0a0a0f] data-[active=true]:border-white"
        data-active={i === 0 ? 'true' : 'false'}
      >
        {c.label}
      </button>
    ))}
  </div>

  <div id="portfolio-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
    {items.map((item) => (
      <a
        href="#inquire"
        data-cats={item.cat}
        data-track="cta-portfolio-inquire"
        class="portfolio-card group p-7 rounded-3xl border border-white/10 hover:border-[#22f5ff]/30 transition-colors bg-white/[0.015]"
      >
        <h3 class="font-semibold text-lg mb-2 group-hover:text-[#22f5ff] transition-colors">{item.name}</h3>
        <p class="text-sm text-white/60">{item.blurb}</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[#22f5ff]">Inquire for this use →</span>
      </a>
    ))}
  </div>

  <p class="mt-6 text-xs text-white/40">
    Internal guide:
    <a href="#positioning" class="underline underline-offset-4 hover:text-white/70">The Opportunity</a>
    <span aria-hidden="true"> • </span>
    <a href="#why" class="underline underline-offset-4 hover:text-white/70">Why this domain</a>
    <span aria-hidden="true"> • </span>
    <a href="#pricing" class="underline underline-offset-4 hover:text-white/70">Pricing</a>
    <span aria-hidden="true"> • </span>
    <a href="#faq" class="underline underline-offset-4 hover:text-white/70">FAQ</a>
  </p>
</section>

<script>
  const buttons = document.querySelectorAll('.portfolio-filter');
  const cards = document.querySelectorAll('.portfolio-card');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';
      buttons.forEach((b) => {
        b.setAttribute('data-active', b === btn ? 'true' : 'false');
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      cards.forEach((card) => {
        const cats = (card.getAttribute('data-cats') || '').split(' ');
        const show = filter === 'all' || cats.includes(filter);
        (card as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>
